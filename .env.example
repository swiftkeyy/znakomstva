# ===== BOT =====
# Telegram Bot API token from @BotFather
BOT_TOKEN=8710534530:AAFoVuItRevurH0iz15FOx66Zl3tMKB3Mt0

# Bot username (without @) for referral links
BOT_USERNAME=my_polovinka_bot

# Comma-separated list of admin Telegram user IDs
ADMIN_USER_IDS=123456789,987654321

# ===== DATABASE =====
# PostgreSQL connection URL with asyncpg driver
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://bot_user:bot_password@localhost:5432/dating_bot

# Database connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== REDIS =====
# Redis connection URL for caching and rate limiting
REDIS_URL=redis://localhost:6379/0

# Redis connection pool size
REDIS_POOL_SIZE=10

# ===== OPENROUTER AI =====
# OpenRouter API key (get free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=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

# OpenRouter API base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI models for different tasks (free tier models)
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_REASONING_MODEL=meta-llama/llama-3.2-3b-instruct:free

# OpenRouter request timeout in seconds
OPENROUTER_TIMEOUT=60

# ===== PAYMENTS =====
# Telegram Stars payment provider token
TELEGRAM_PAYMENT_TOKEN=your_telegram_payment_token

# ЮKassa credentials for alternative payment method
YUKASSA_SHOP_ID=your_yukassa_shop_id
YUKASSA_SECRET_KEY=your_yukassa_secret_key

# ===== MONITORING =====
# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===== FEATURES =====
# Enable/disable Speed Dating feature
ENABLE_SPEED_DATING=true

# Enable/disable Deep Search feature (premium only)
ENABLE_DEEP_SEARCH=true

# Maximum number of photos per profile
MAX_PHOTO_COUNT=15

# Maximum video duration in seconds
MAX_VIDEO_DURATION=30

# Maximum voice greeting duration in seconds
MAX_VOICE_DURATION=90

# ===== RATE LIMITS =====
# Swipes per hour for free users
RATE_LIMIT_SWIPES_FREE=100

# Swipes per hour for premium users
RATE_LIMIT_SWIPES_PREMIUM=500

# Messages per hour per chat for free users
RATE_LIMIT_MESSAGES_FREE=50

# Messages per hour per chat for premium users
RATE_LIMIT_MESSAGES_PREMIUM=250

# AI suggestions per day for free users (unlimited for premium)
RATE_LIMIT_AI_SUGGESTIONS_FREE=10

# ===== CRYSTALS =====
# Cost of SuperSwipe in crystals
SUPERSWIPE_COST=10

# Cost of 24-hour boost in crystals
BOOST_COST_24H=50

# Cost of 72-hour boost in crystals
BOOST_COST_72H=100

# Crystals awarded for successful referral registration
REFERRAL_CRYSTALS_REGISTRATION=100

# Crystals awarded when referred user purchases premium
REFERRAL_CRYSTALS_PREMIUM=500
